---
import SocialBadge from "@/components/SocialBadge.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import LinkedinIcon from "@/components/icons/LinkedinIcon.astro";
import MailboxIcon from "@/components/icons/MailboxIcon.astro";
---

<section class="mb-20">
  <div
    class="font-mono text-[13px] tracking-[.08em] uppercase text-primary-500 mb-3.5"
  >
    Site Reliability Engineer
  </div>
  <h1
    class="text-[56px] font-extrabold tracking-tight leading-[1.05] mb-[18px]"
  >
    Lisandro Marchionni
  </h1>
  <p
    class="text-[19px] leading-[1.6] text-text-600 dark:text-text-400 max-w-[640px] mb-[26px] text-pretty"
  >
    Administro redes con ruteo dinámico y entornos de aplicaciones
    virtualizados y en contenedores. Me dedico a que los servicios estén
    disponibles, monitoreados y sean fáciles de volver a levantar.
  </p>
  <div class="flex flex-wrap gap-2.5">
    <SocialBadge href="https://github.com/lichodev">
      <GitHubIcon /> GitHub
    </SocialBadge>
    <SocialBadge href="https://www.linkedin.com/in/lisandromarcho">
      <LinkedinIcon />
      LinkedIn
    </SocialBadge>
    <SocialBadge href="mailto:marchionni.lisandro@gmail.com">
      <MailboxIcon />
      marchionni.lisandro@gmail.com
    </SocialBadge>
  </div>
</section>
