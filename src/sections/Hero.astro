---
import Button from "@/components/Button.astro";
import SocialBadge from "@/components/SocialBadge.astro";
import HeroDiagram from "@/components/HeroDiagram.astro";
import LinkedinIcon from "@/components/icons/LinkedinIcon.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mb-20 grid grid-cols-1 lg:grid-cols-[1fr_480px] gap-10 items-center">
  <div>
    <div
      class="font-mono text-xl tracking-[.08em] uppercase text-primary-700 dark:text-primary-500 mb-4"
    >
      Lisandro Marchionni
    </div>
    <h1
      class="text-[34px] sm:text-[44px] font-extrabold tracking-tight leading-[1.1] max-w-[820px] mb-5 text-balance"
    >
      {t.hero.headline}
    </h1>
    <p
      class="text-[19px] leading-[1.6] text-text-600 dark:text-text-400 max-w-[640px] mb-[26px] text-pretty"
    >
      {t.hero.lead}
    </p>
    <div class="flex flex-wrap items-center gap-2.5">
      <Button variant="primary" href="#contacto">{t.hero.cta}</Button>
      <SocialBadge href="https://www.linkedin.com/in/lisandromarcho">
        <LinkedinIcon />
        LinkedIn
      </SocialBadge>
    </div>
  </div>
  <HeroDiagram lang={lang} class="hidden lg:block w-full h-auto" />
</section>
