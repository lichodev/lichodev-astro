---
import SectionHeader from "@/components/SectionHeader.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="servicios" class="mb-16">
  <SectionHeader title={t.services.title} />
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {
      t.services.items.map((service) => (
        <article class="flex flex-col rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-6">
          <div class="font-mono text-xs tracking-[.06em] uppercase text-primary-500 mb-3">
            {service.label}
          </div>
          <h3 class="text-lg font-bold leading-snug mb-2 text-pretty">
            {service.title}
          </h3>
          <p class="text-sm leading-relaxed text-text-600 dark:text-text-400 mb-4 text-pretty">
            {service.body}
          </p>
          <ul class="flex flex-col gap-1.5 text-sm mb-5">
            {service.includes.map((item) => (
              <li class="flex gap-2">
                <span class="text-primary-500" aria-hidden="true">
                  ›
                </span>
                {item}
              </li>
            ))}
          </ul>
          {service.monitoring && (
            <span class="mt-auto self-start font-mono text-xs font-medium px-3 py-1.5 rounded-md border bg-accent-100 dark:bg-accent-800 text-accent-700 dark:text-accent-200 border-accent-200 dark:border-accent-700">
              {t.services.monitoringBadge}
            </span>
          )}
        </article>
      ))
    }
  </div>
</section>
