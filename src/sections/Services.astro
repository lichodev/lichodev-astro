---
import SectionHeader from "@/components/SectionHeader.astro";
import ServiceIcon, { type ServiceIconName } from "@/components/icons/ServiceIcon.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="servicios" class="mb-16">
  <SectionHeader title={t.services.title} />
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 mb-8">
    {
      t.services.items.map((service) => (
        <article class="border-t-2 border-primary-500 pt-5">
          <ServiceIcon
            name={service.icon as ServiceIconName}
            class="h-9 w-9 mb-3 text-primary-600 dark:text-primary-500"
          />
          <h3 class="text-xl font-bold mb-2">{service.label}</h3>
          <p class="leading-relaxed text-text-600 dark:text-text-400 text-pretty">
            {service.body}
          </p>
        </article>
      ))
    }
  </div>
  <p class="text-sm text-text-600 dark:text-text-400">
    {t.services.monitoringNote}
  </p>
</section>
