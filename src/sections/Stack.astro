---
import TechTag from "@/components/TechTag.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="stack">
  <SectionHeader title={t.stack.title} />
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      t.stack.groups.map((group) => (
        <div class="rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-5">
          <div class="font-mono text-xs tracking-[.06em] uppercase text-primary-500 mb-3.5">
            {group.label}
          </div>
          <div class="flex flex-wrap gap-1.5">
            {group.tags.map((tag) => (
              <TechTag>{tag}</TechTag>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
