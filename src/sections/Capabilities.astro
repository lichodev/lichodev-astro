---
const CAPABILITIES = [
  {
    label: "Redes",
    body: "Diseño y operación de redes con ruteo dinámico, VLANs y direccionamiento IPv4/IPv6, incluyendo routers de frontera y túneles.",
  },
  {
    label: "Infraestructura",
    body: "Entornos de aplicaciones virtualizados y en contenedores: ciclo de vida completo de los servicios, alta disponibilidad y recuperación.",
  },
  {
    label: "Automatización",
    body: "Pipelines de CI/CD, scripting e integraciones entre plataformas para sacar del medio las tareas manuales y los errores humanos.",
  },
];
---

<section class="mb-14 grid grid-cols-1 sm:grid-cols-3 gap-4">
  {
    CAPABILITIES.map((c) => (
      <div class="rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-6">
        <div class="font-mono text-xs tracking-[.06em] uppercase text-primary-500 mb-3">
          {c.label}
        </div>
        <p class="text-sm leading-relaxed text-text-600 dark:text-text-400 text-pretty">
          {c.body}
        </p>
      </div>
    ))
  }
</section>
