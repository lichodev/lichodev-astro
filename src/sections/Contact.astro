---
import Button from "@/components/Button.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import LinkedinIcon from "@/components/icons/LinkedinIcon.astro";
import MailboxIcon from "@/components/icons/MailboxIcon.astro";

const inputClasses =
  "bg-background-100 border border-text-200 rounded-lg px-3.5 py-2.5 text-sm font-sans text-text-950 outline-hidden focus:border-accent-500";
---

<section id="contacto">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 items-start">
    <div>
      <slot name="before-text" />
      <p
        class="text-[17px] leading-relaxed text-text-600 max-w-[420px] mb-5 text-pretty"
      >
        Si tenés un proyecto de infraestructura, redes o automatización — o
        simplemente querés charlar de Kubernetes — escribime.
      </p>
      <div
        class="flex flex-col gap-2.5 font-mono text-[13px] [&_svg]:w-3.5 [&_svg]:h-3.5"
      >
        <a
          href="mailto:marchionni.lisandro@gmail.com"
          class="flex items-center gap-2"
          ><MailboxIcon />marchionni.lisandro@gmail.com</a
        >
        <a
          href="https://github.com/lichodev"
          target="_blank"
          class="flex items-center gap-2"><GitHubIcon />github.com/lichodev</a
        >
        <a
          href="https://linkedin.com/in/lisandromarcho"
          target="_blank"
          class="flex items-center gap-2"
          ><LinkedinIcon />linkedin.com/in/lisandromarcho</a
        >
      </div>
      <slot name="after-text" />
    </div>

    <div
      class="rounded-2xl border border-text-200 bg-background-50 p-6"
    >
      <h2 class="text-2xl font-bold mb-5 pb-3 border-b border-text-200">
        Contacto
      </h2>
      <form id="contact-form" class="flex flex-col gap-4">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm text-text-600">Nombre</span>
          <input
            name="name"
            type="text"
            required
            placeholder="Tu nombre"
            class={inputClasses}
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm text-text-600">Email</span>
          <input
            name="email"
            type="email"
            required
            placeholder="tu@email.com"
            class={inputClasses}
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm text-text-600">Mensaje</span
          >
          <textarea
            name="message"
            rows="4"
            required
            placeholder="Contame en qué puedo ayudarte..."
            class={`${inputClasses} resize-y`}></textarea>
        </label>
        <input
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />
        <div>
          <Button variant="primary" type="submit">Enviar</Button>
        </div>
        <p id="contact-error" role="alert" class="hidden text-sm text-accent-700">
        </p>
      </form>

      <div id="contact-sent" class="hidden flex-col gap-2.5 py-6">
        <div class="text-[17px] font-bold text-primary-500">
          Mensaje enviado
        </div>
        <div class="text-sm text-text-600">
          Gracias por escribir. Te respondo a la brevedad.
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions, isInputError } from "astro:actions";
  import { RECAPTCHA_SITE_KEY } from "astro:env/client";

  type Grecaptcha = {
    ready: (callback: () => void) => void;
    execute: (siteKey: string, options: { action: string }) => Promise<string>;
  };

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const sent = document.getElementById("contact-sent");
  const errorBox = document.getElementById("contact-error");
  const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  // El script de reCAPTCHA se carga recién cuando alguien usa el formulario,
  // para no sumarlo a todas las páginas (el formulario está en el footer).
  let recaptchaLoading: Promise<Grecaptcha> | undefined;

  function loadRecaptcha(): Promise<Grecaptcha> {
    recaptchaLoading ??= new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = `https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`;
      script.async = true;
      script.onload = () => {
        const grecaptcha = (window as unknown as { grecaptcha: Grecaptcha })
          .grecaptcha;
        grecaptcha.ready(() => resolve(grecaptcha));
      };
      script.onerror = () => {
        recaptchaLoading = undefined;
        reject(new Error("No se pudo cargar reCAPTCHA"));
      };
      document.head.append(script);
    });
    return recaptchaLoading;
  }

  async function getRecaptchaToken(): Promise<string> {
    const grecaptcha = await loadRecaptcha();
    return grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: "contact" });
  }

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  const FALLBACK_ERROR =
    "No se pudo enviar el mensaje. Escribime directamente a marchionni.lisandro@gmail.com.";

  form?.addEventListener("focusin", () => void loadRecaptcha().catch(() => {}), {
    once: true,
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    errorBox?.classList.add("hidden");

    const label = submit?.textContent ?? "Enviar";
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Enviando…";
    }

    let error: unknown;
    try {
      const data = new FormData(form);
      data.set("recaptchaToken", await getRecaptchaToken());
      ({ error } = await actions.contact(data));
    } catch {
      error = new Error("recaptcha");
    }

    if (submit) {
      submit.disabled = false;
      submit.textContent = label;
    }

    if (error) {
      if (isInputError(error as never)) {
        showError(
          "Revisá los campos: el email tiene que ser válido y el mensaje de al menos 10 caracteres.",
        );
      } else if ((error as { code?: string }).code === "FORBIDDEN") {
        showError(
          "No pudimos verificar que no seas un bot. Probá de nuevo o escribime a marchionni.lisandro@gmail.com.",
        );
      } else {
        showError(FALLBACK_ERROR);
      }
      return;
    }

    form.classList.add("hidden");
    sent?.classList.remove("hidden");
    sent?.classList.add("flex");
  });
</script>
