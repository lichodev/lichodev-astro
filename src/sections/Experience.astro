---
import SectionHeader from "@/components/SectionHeader.astro";
import TechTag from "@/components/TechTag.astro";
import Credentials from "@/sections/Credentials.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experiencia" class="mb-16">
  <SectionHeader title={t.experience.title} />
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    {
      t.experience.cases.map((item) => (
        <article class="flex flex-col rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-6">
          <div class="font-mono text-xs tracking-[.06em] uppercase text-primary-500 mb-1">
            {item.area}
          </div>
          <div class="text-xs text-text-600 dark:text-text-400 mb-3">
            {item.sector}
          </div>
          <h3 class="text-lg font-bold leading-snug mb-2 text-pretty">
            {item.title}
          </h3>
          <p class="text-sm leading-relaxed text-text-600 dark:text-text-400 mb-5 text-pretty">
            {item.body}
          </p>
          <div class="mt-auto flex flex-wrap gap-1.5">
            {item.tags.map((tag) => (
              <TechTag variant="outline">{tag}</TechTag>
            ))}
          </div>
        </article>
      ))
    }
  </div>
  <Credentials lang={lang} />
</section>
