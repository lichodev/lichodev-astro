---
import SectionHeader from "@/components/SectionHeader.astro";
import TechLogos from "@/components/TechLogos.astro";
import DiplomaIcon from "@/components/icons/DiplomaIcon.astro";
import CaseDiagram, { type CaseDiagramName } from "@/components/CaseDiagram.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Clases compartidas por las filas de casos y la fila de formación.
const rowClass =
  "grid grid-cols-1 sm:col-span-2 lg:col-span-3 sm:grid-cols-subgrid gap-y-3 py-7 border-t border-text-200 dark:border-text-800 first:border-t-0 first:pt-0";
const metricClass =
  "text-5xl font-extrabold tracking-tight text-primary-600 dark:text-primary-500 leading-none whitespace-nowrap";
// Tarjeta de credencial; en mobile las insignias usan el mismo formato.
const cardClass =
  "flex items-center gap-4 rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 px-5 py-4 sm:max-w-[380px]";
const metricLabelClass = "font-mono text-lg text-text-600 dark:text-text-400 mt-2";
---

<section id="experiencia" class="mb-16">
  <SectionHeader title={t.experience.title} />
  <ol class="sm:grid sm:grid-cols-[max-content_1fr] lg:grid-cols-[max-content_1fr_200px] sm:gap-x-8">
    {
      t.experience.cases.map((caseStudy) => (
        <li class={rowClass}>
          <div>
            <div class={metricClass}>
              {caseStudy.metric}
            </div>
            <div class={metricLabelClass}>
              {caseStudy.metricLabel}
            </div>
          </div>
          <div>
            <h3 class="text-lg font-bold leading-snug mb-2 text-pretty">
              {caseStudy.title}
            </h3>
            <div class="flex flex-col gap-2 mb-4 last:mb-0 max-w-[640px]">
              {[caseStudy.body].flat().map((paragraph) => (
                <p class="leading-relaxed text-text-600 dark:text-text-400 text-pretty">
                  {paragraph}
                </p>
              ))}
            </div>
            {caseStudy.logos.length > 0 && <TechLogos names={caseStudy.logos} />}
          </div>
          <CaseDiagram
            name={caseStudy.diagram as CaseDiagramName}
            class="hidden lg:block w-full h-auto self-center"
          />
        </li>
      ))
    }
    <li class={rowClass}>
      <div>
        <div class={metricClass}>{t.experience.credentialsMetric}</div>
        <div class={metricLabelClass}>{t.experience.credentialsLabel}</div>
      </div>
      <ul class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-6 lg:col-span-2">
        {
          t.experience.credentials.map((credential) =>
            "url" in credential ? (
              <li>
                <a
                  href={credential.url}
                  target="_blank"
                  rel="noopener"
                  class={`${cardClass} sm:block sm:p-0 sm:border-0 sm:bg-transparent sm:dark:bg-transparent sm:max-w-none transition-transform sm:hover:scale-105`}
                >
                  <img
                    src={credential.image}
                    alt={`${credential.title} · ${credential.detail}`}
                    width="173"
                    height="160"
                    loading="lazy"
                    class="h-14 w-14 sm:h-40 sm:w-auto shrink-0 object-contain scale-125 sm:scale-100"
                  />
                  <div class="sm:hidden">
                    <div class="font-bold leading-snug text-pretty">
                      {credential.title}
                    </div>
                    <div class="text-sm text-text-600 dark:text-text-400 mt-1">
                      {credential.detail}
                    </div>
                  </div>
                </a>
              </li>
            ) : (
              <li class={cardClass}>
                <DiplomaIcon class="h-14 w-14 sm:h-12 sm:w-12 shrink-0 text-primary-600 dark:text-primary-500" />
                <div>
                  <div class="font-bold leading-snug text-pretty">
                    {credential.title}
                  </div>
                  <div class="text-sm text-text-600 dark:text-text-400 mt-1">
                    {credential.detail}
                  </div>
                </div>
              </li>
            ),
          )
        }
      </ul>
    </li>
  </ol>
</section>
