---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import SectionHeader from "@/components/SectionHeader.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];
---

{
  latest && (
    <section class="mb-16">
      <SectionHeader title="Blog" />
      <a
        href={`/blog/${latest.id}/`}
        class="block rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-5 transition-colors hover:border-accent-400 dark:hover:border-accent-500"
      >
        <div class="font-mono text-xs text-text-600 dark:text-text-400 mb-2">
          <FormattedDate date={latest.data.pubDate} />
        </div>
        <div class="text-lg font-bold mb-2">{latest.data.title}</div>
        <p class="text-sm leading-relaxed text-text-600 dark:text-text-400 mb-2.5 max-w-[640px]">
          {latest.data.description}
        </p>
        <span class="text-sm text-accent-700 dark:text-accent-300">→</span>
      </a>
    </section>
  )
}
