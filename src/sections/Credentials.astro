---
import DiplomaIcon from "@/components/icons/DiplomaIcon.astro";
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<div>
  <h3
    class="font-mono text-xs tracking-[.06em] uppercase text-text-600 dark:text-text-400 mb-3"
  >
    {t.experience.credentialsTitle}
  </h3>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {
      t.experience.credentials.map((credential) => {
        const url = "url" in credential ? credential.url : undefined;
        const image = "image" in credential ? credential.image : undefined;
        const Tag = url ? "a" : "div";
        return (
          <Tag
            href={url}
            target={url ? "_blank" : undefined}
            rel={url ? "noopener" : undefined}
            class:list={[
              "flex flex-col items-center text-center gap-3 rounded-2xl border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900 p-6",
              url &&
                "transition-colors hover:border-accent-400 dark:hover:border-accent-500",
            ]}
          >
            <div class="h-28 flex items-center justify-center">
              {image ? (
                <img
                  src={image}
                  alt=""
                  width="121"
                  height="112"
                  loading="lazy"
                  class="h-28 w-auto object-contain"
                />
              ) : (
                <DiplomaIcon class="h-24 w-24 text-primary-500" />
              )}
            </div>
            <div>
              <div class="text-sm font-semibold text-pretty">
                {credential.title}
              </div>
              <div class="text-xs text-text-600 dark:text-text-400 mt-1">
                {credential.detail}
                {url && <span aria-hidden="true"> ↗</span>}
              </div>
            </div>
          </Tag>
        );
      })
    }
  </div>
</div>
