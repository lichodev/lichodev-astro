---
// Íconos de línea para cada servicio. Mismo trazo que los diagramas.
export type ServiceIconName = "network" | "virtualization" | "training" | "audit";

interface Props {
  name: ServiceIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "network" && (
      <>
        <rect x="3" y="13" width="18" height="6" rx="1.5" />
        <path d="M8 13 6.5 6M16 13l1.5-7" />
        <path d="M7 16h.01M10 16h.01M14 16h4" />
      </>
    )
  }
  {
    name === "virtualization" && (
      <>
        <rect x="4" y="3.5" width="16" height="5" rx="1.2" />
        <rect x="4" y="9.5" width="16" height="5" rx="1.2" />
        <rect x="4" y="15.5" width="16" height="5" rx="1.2" />
        <path d="M7.5 6h.01M7.5 12h.01M7.5 18h.01M11 6h5.5M11 12h5.5M11 18h5.5" />
      </>
    )
  }
  {
    name === "training" && (
      <>
        <rect x="3" y="4" width="18" height="11" rx="1.5" />
        <path d="M12 15v5M8 20h8" />
        <path d="m7 11.5 3-3 2.5 2 4.5-4" />
      </>
    )
  }
  {
    name === "audit" && (
      <>
        <path d="M14 20H6a1.5 1.5 0 0 1-1.5-1.5v-14A1.5 1.5 0 0 1 6 3h8a1.5 1.5 0 0 1 1.5 1.5V9" />
        <path d="M7.5 7h5M7.5 10.5h3" />
        <circle cx="16" cy="15" r="3.5" />
        <path d="m18.5 17.5 2.5 2.5" />
      </>
    )
  }
</svg>
