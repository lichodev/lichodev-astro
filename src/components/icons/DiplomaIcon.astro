---
// Ícono de título universitario: diploma enrollado con sello.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Hoja del título -->
  <rect x="6" y="12" width="44" height="32" rx="3" />
  <path d="M14 22h28M14 29h20M14 36h12" />
  <!-- Sello con cintas -->
  <circle cx="46" cy="40" r="9" fill="currentColor" fill-opacity="0.15" />
  <circle cx="46" cy="40" r="4" />
  <path d="M41 47.5 39 58l7-4 7 4-2-10.5" />
</svg>
