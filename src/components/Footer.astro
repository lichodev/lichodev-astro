---
import Contact from "@/sections/Contact.astro";
import { homePath, type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<!-- El footer es siempre claro (también en modo oscuro), por eso su contenido no usa variantes dark: -->
<footer
  class="bg-text-50 text-text-900 [color-scheme:light] px-6 py-10 sm:p-10 sm:mt-16 mx-auto max-w-[1080px]"
>
  <Contact lang={lang}>
    <a
      slot="before-text"
      href={homePath(lang)}
      class="flex items-center mb-6"
      aria-label={t.footer.homeLabel}
    >
      <img
        src="/lichodev-logo.webp"
        class="m-0 h-20 mix-blend-multiply"
        alt="lichodev Logo"
      />
    </a>
  </Contact>
  <p class="mt-10 font-mono text-xs text-text-600">
    © {year} Lisandro Marchionni
  </p>
</footer>
