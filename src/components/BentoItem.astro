---
import ExternalLink from "@/components/icons/ExternalLink.astro";
interface Props {
  "lg:size"?: 4 | 5 | 6 | 7 | 8;
  title: string;
  href: string;
  img: string;
}

const { "lg:size": size, title, img, href } = Astro.props;

const DEFAULT_SIZE = "md:col-span-6 col-span-12";

const COLUMN_SIZES = {
  4: `lg:col-span-4 ${DEFAULT_SIZE}`,
  5: `lg:col-span-5 ${DEFAULT_SIZE}`,
  6: `lg:col-span-6 ${DEFAULT_SIZE}`,
  7: `lg:col-span-7 ${DEFAULT_SIZE}`,
  8: `lg:col-span-8 ${DEFAULT_SIZE}`,
};
---

<article
  class=`${size ? COLUMN_SIZES[size] : "col-span-12"} rounded-2xl overflow-hidden border border-text-200 dark:border-text-800 bg-background-50 dark:bg-background-900`
>
  <a
    href={href}
    target="_blank"
    role="img"
    aria-label={title}
    class="block h-[160px] bg-center bg-cover"
    style=`background-image: url(${img});`
  >
  </a>
  <div class="p-4">
    <h3 class="font-bold mb-2.5">
      <a href={href} target="_blank" class="flex gap-2 items-center">
        {title}
        <ExternalLink />
      </a>
    </h3>
    <div class="flex flex-wrap gap-1.5">
      <slot />
    </div>
  </div>
</article>
