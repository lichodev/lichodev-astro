---
interface Props {
  job: string;
  at: string;
  atUrl?: string;
  date?: string;
}

const { job, at, atUrl, date } = Astro.props;
---

<article class="flex gap-5 max-w-[70ch]">
  <div class="flex flex-col items-center pt-1.5">
    <span class="w-3 h-3 rounded-full bg-primary-500 shrink-0"></span>
    <span
      class="timeline-line w-px flex-1 bg-background-200 dark:bg-background-800 mt-1.5"
    ></span>
  </div>
  <div class="pb-8">
    <h3 class="font-bold">
      {job}
      <span class="font-semibold text-text-600 dark:text-text-400">
        @{" "}
        {
          atUrl ? (
            <a
              href={atUrl}
              target="_blank"
              class="text-primary-500 no-underline hover:underline"
            >
              {at}
            </a>
          ) : (
            <span class="text-primary-500">{at}</span>
          )
        }
      </span>
    </h3>
    <span class="font-mono text-sm text-text-600 dark:text-text-400"
      >{date}</span
    >
    <div class="prose prose-stone dark:prose-invert job-info pt-2">
      <slot />
    </div>
  </div>
</article>

<style is:global>
  .job-info,
  .job-info * {
    max-width: none;
  }

  .job-info p,
  .job-info ul {
    margin: 0 0 0.25rem;
  }
  .job-info ul li {
    margin: 0;
  }
</style>

<style>
  article:last-child .timeline-line {
    display: none;
  }
</style>
