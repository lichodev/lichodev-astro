---
// Topología del hero: datacenter con oficina, sede y sucursal (con un camino alternativo),
// conexión a la nube y monitoreo. Los paquetes se pausan con prefers-reduced-motion.
import { type Lang, useTranslations } from "@/i18n";

interface Props {
  lang: Lang;
  class?: string;
}

const t = useTranslations(Astro.props.lang).hero.diagram;

// Centro de cada sitio; el router se dibuja relativo a este punto.
const sites = [
  { x: 70, y: 70, label: t.sites[0] },
  { x: 70, y: 250, label: t.sites[1] },
  { x: 330, y: 250, label: t.sites[2] },
];
const dc = { x: 200, y: 160 };
const monitor = { x: 330, y: 70 };
const cloud = { x: 200, y: 0 };

const nodeFill = "fill-background-50 dark:fill-background-950";
const nodeStroke = "stroke-text-500";
const label = "fill-text-600 dark:fill-text-400 font-mono text-[13px]";
---

<svg
  viewBox="0 -50 400 360"
  role="img"
  aria-label={t.label}
  class:list={["hero-diagram", Astro.props.class]}
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- Enlaces -->
  <g class="stroke-text-300 dark:stroke-text-700" stroke-width="1.5">
    {sites.map((s) => <path d={`M${s.x} ${s.y} L${dc.x} ${dc.y}`} />)}
    <path d={`M${cloud.x} ${cloud.y} L${dc.x} ${dc.y}`} />
    <path d={`M${sites[0].x} ${sites[0].y + 20} L${sites[1].x} ${sites[1].y - 20}`} stroke-dasharray="5 6" />
  </g>
  <path
    d={`M${monitor.x} ${monitor.y} L${dc.x} ${dc.y}`}
    class="stroke-primary-600 dark:stroke-primary-500"
    stroke-width="1.5"
    stroke-dasharray="2 5"
  />

  <!-- Paquetes -->
  <g class="packets fill-primary-600 dark:fill-primary-500">
    <circle r="3.5">
      <animateMotion dur="4s" repeatCount="indefinite" path="M70 70 L200 160 L330 250" />
    </circle>
    <circle r="3.5">
      <animateMotion dur="4.5s" repeatCount="indefinite" path="M330 250 L200 160 L70 250" />
    </circle>
    <circle r="3.5">
      <animateMotion dur="3s" repeatCount="indefinite" path="M70 230 L70 90" />
    </circle>
    <circle r="3.5">
      <animateMotion dur="2.5s" repeatCount="indefinite" path="M200 160 L200 0" />
    </circle>
  </g>

  <!-- Sedes -->
  {
    sites.map((s) => (
      <g transform={`translate(${s.x} ${s.y})`}>
        <rect x="-28" y="-20" width="56" height="40" rx="8" class:list={[nodeFill, nodeStroke]} stroke-width="1.5" />
        <rect x="-14" y="-2" width="28" height="10" rx="2" class={nodeStroke} stroke-width="1.5" />
        <path d="M-8 -2 -10 -10M8 -2l2-8" class={nodeStroke} stroke-width="1.5" />
        <path d="M-9 3h.01M-5 3h.01" class={nodeStroke} stroke-width="2" />
        <text y="38" text-anchor="middle" class={label}>{s.label}</text>
      </g>
    ))
  }

  <!-- Nube -->
  <g transform={`translate(${cloud.x} ${cloud.y})`}>
    <path
      d="M-38 22H38A20 20 0 0 0 40 -16A28 28 0 0 0 -12 -26A22 22 0 0 0 -38 22Z"
      class:list={[nodeFill, nodeStroke]}
      stroke-width="1.5"
    />
    <text y="10" text-anchor="middle" class={label}>{t.cloud}</text>
  </g>

  <!-- Datacenter -->
  <g transform={`translate(${dc.x} ${dc.y})`}>
    <rect x="-42" y="-42" width="84" height="84" rx="10" class:list={[nodeFill, "stroke-primary-600 dark:stroke-primary-500"]} stroke-width="1.75" />
    {
      [-26, -6, 14].map((y) => (
        <>
          <rect x="-28" y={y} width="56" height="13" rx="2" class={nodeStroke} stroke-width="1.5" />
          <path d={`M-21 ${y + 6.5}h.01M-10 ${y + 6.5}h22`} class={nodeStroke} stroke-width="1.5" />
        </>
      ))
    }
    <text y="62" text-anchor="middle" class={label}>{t.datacenter}</text>
  </g>

  <!-- Monitoreo -->
  <g transform={`translate(${monitor.x} ${monitor.y})`}>
    <rect x="-42" y="-30" width="84" height="60" rx="8" class:list={[nodeFill, nodeStroke]} stroke-width="1.5" />
    <path d="M-30 -18h20" class={nodeStroke} stroke-width="1.5" />
    <polyline
      points="-30,16 -16,4 -4,10 10,-8 30,0"
      class="stroke-primary-600 dark:stroke-primary-500"
      stroke-width="1.75"
    />
    <text y="50" text-anchor="middle" class={label}>{t.monitoring}</text>
  </g>
</svg>

<script>
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<SVGSVGElement>(".hero-diagram").forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(0);
    });
  }
</script>
