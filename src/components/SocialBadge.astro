---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="flex items-center gap-2 font-sans text-sm font-semibold px-4 py-2.5 rounded-[10px] bg-background-100 dark:bg-background-800 text-text-900 dark:text-text-50 border border-text-200 dark:border-text-800 transition-colors hover:border-text-400 dark:hover:border-text-600"
  href={href}
  target="_blank"
>
  <slot />
</a>
